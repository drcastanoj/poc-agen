{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteRunItems",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/poc-agent-runs"
    },
    {
      "Sid": "EnqueueRun",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:*:*:poc-agent-runs"
    },
    {
      "Sid": "ReadAgentTaskLogs",
      "Effect": "Allow",
      "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:logs:*:*:log-group:/ecs/poc-agent-run:log-stream:*"
    }
  ]
}
