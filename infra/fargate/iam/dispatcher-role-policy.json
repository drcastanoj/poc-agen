{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeRunQueue",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:*:*:poc-agent-runs"
    },
    {
      "Sid": "LaunchAgentTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:*:*:task-definition/poc-agent-run:*",
      "Condition": { "ArnEquals": { "ecs:cluster": "arn:aws:ecs:*:*:cluster/poc-agent-cluster" } }
    },
    {
      "Sid": "PassTaskRolesToECS",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::*:role/poc-agent-task-role",
        "arn:aws:iam::*:role/poc-agent-task-execution-role"
      ],
      "Condition": { "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" } }
    },
    {
      "Sid": "MarkRunDispatched",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:*:*:table/poc-agent-runs"
    }
  ]
}
