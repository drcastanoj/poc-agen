{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPatchHandoff",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::REPLACE_WITH_CACHE_BUCKET/runs/*"
    },
    {
      "Sid": "WriteGithub",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:*:*:parameter/poc/github-token-write"
    },
    {
      "Sid": "DecryptGithubToken",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.us-east-1.amazonaws.com" } }
    },
    {
      "Sid": "ReportPublishResult",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:*:*:table/poc-agent-runs"
    }
  ]
}
